{
  "name": "@anisync/desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -w -p electron/tsconfig.json\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "electron:dev": "electron .",
    "package": "electron-builder --win",
    "clean": "rimraf dist out release"
  },
  "dependencies": {
    "@anisync/shared": "1.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.0",
    "framer-motion": "^11.1.0",
    "lucide-react": "^0.378.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.anisync.desktop",
    "productName": "AniSync",
    "directories": { "output": "release" },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*.js",
      "!node_modules"
    ]
  }
}
