<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for VPN compatibility (Proton VPN, Cloudflare WARP).
  
  VPN apps install user CA certificates to tunnel traffic.
  Android 7+ (API 24+) by default only trusts system CAs.
  Xiaomi/MIUI is stricter than Samsung about this.
  
  This config tells the app to also trust user-installed CAs,
  which allows anime content to load through VPN tunnels.
-->
<network-security-config>
    <!-- Trust both system and user-installed CA certificates -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
